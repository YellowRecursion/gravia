# Normalize text in Git and use LF across platforms.
* text=auto eol=lf

# Windows command scripts require CRLF on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit text types, including files that may be new or empty.
*.cs text diff=csharp
*.csproj text
*.sln text
*.slnx text
*.props text
*.targets text
*.resx text
*.py text
*.ps1 text
*.sh text
*.js text
*.mjs text
*.cjs text
*.ts text
*.tsx text
*.jsx text
*.json text
*.yaml text
*.yml text
*.toml text
*.xml text
*.html text
*.css text
*.scss text
*.md text
*.svg text
*.csv text
*.tsv text

# Binary assets must never undergo line-ending conversion or text merging.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
