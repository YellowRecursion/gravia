{
  "Desktop": {
    "Enabled": true
  },
  "InMemoryLogging": {
    "CapacityBytes": 16777216,
    "MaxEntryBytes": 16384,
    "MaxReadBytes": 262144,
    "MaxReadEntries": 500,
    "MaxScanEntries": 2048,
    "CollapseConsecutive": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "Gravia": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  }
}
