<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Gravia.Application/Gravia.Application.csproj" />
    <ProjectReference Include="../Gravia.Infrastructure/Gravia.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Gravia.Desktop/*.cjs;../Gravia.Desktop/package.json"
             Link="Desktop/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ActualLab.Fusion.Server" Version="14.4.11" />
  </ItemGroup>
  <Target Name="RestoreDesktop"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipDesktopRestore)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/../Gravia.Desktop/package.json;$(MSBuildProjectDirectory)/../Gravia.Desktop/package-lock.json"
          Outputs="$(MSBuildProjectDirectory)/../Gravia.Desktop/node_modules/.package-lock.json">
    <PropertyGroup>
      <DesktopNpm Condition="$([MSBuild]::IsOSPlatform('Windows'))">npm.cmd</DesktopNpm>
      <DesktopNpm Condition="'$(DesktopNpm)' == ''">npm</DesktopNpm>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../Gravia.Desktop" Command="$(DesktopNpm) ci --no-audit --no-fund" />
  </Target>
  <Target Name="PrepareDesktop" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreDesktop"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipDesktopRestore)' != 'true'">
    <PropertyGroup>
      <DesktopNpm Condition="$([MSBuild]::IsOSPlatform('Windows'))">npm.cmd</DesktopNpm>
      <DesktopNpm Condition="'$(DesktopNpm)' == ''">npm</DesktopNpm>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../Gravia.Desktop" Command="node -e &quot;require('electron')&quot;" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../Gravia.Desktop" Command="$(DesktopNpm) run build" />
  </Target>
  <Target Name="IncludeDesktopWebAssets" BeforeTargets="AssignTargetPaths" DependsOnTargets="PrepareDesktop">
    <ItemGroup>
      <_DesktopWebAsset Include="$(MSBuildProjectDirectory)/../Gravia.Desktop/dist/**/*" />
      <Content Include="@(_DesktopWebAsset)"
               Link="Desktop/wwwroot/%(_DesktopWebAsset.RecursiveDir)%(_DesktopWebAsset.Filename)%(_DesktopWebAsset.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
