{
  "name": "gravia-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Gravia Lab desktop shell and web renderer.",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "setup": "node -e \"require('electron')\"",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run lint && npm run typecheck && vite build",
    "typecheck": "tsc -p renderer/tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run build && npm test",
    "api:generate": "orval --config orval.config.ts",
    "smoke": "node tests/desktop-smoke.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.102.8",
    "@xyflow/react": "12.11.6",
    "antd": "6.6.3",
    "dockview-react": "8.3.1",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.13",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "orval": "8.32.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
